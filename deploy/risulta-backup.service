[Unit]
Description=Risulta scheduled database backup
After=risulta-sprout.service

[Service]
Type=oneshot
User=risulta-sprout
Group=risulta-sprout
Environment=SB_DATA_DIR=/var/lib/risulta-sprout
EnvironmentFile=/etc/risulta-sprout/risulta-sprout.env
ExecStart=/usr/bin/python3 /usr/local/lib/risulta/backup-runner.py --data-dir ${SB_DATA_DIR}
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/risulta-sprout
