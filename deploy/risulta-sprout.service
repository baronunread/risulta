[Unit]
Description=Risulta web analytics
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=risulta-sprout
Group=risulta-sprout
# Built-in maintenance runs in a second process on the same database, which the
# default EXCLUSIVE SQLite locking (sproutboat 0.12.4+) would refuse.
Environment=SB_SQLITE_EXCLUSIVE=0
EnvironmentFile=/etc/risulta-sprout/risulta-sprout.env
ExecStart=/usr/local/bin/risulta-sprout
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StateDirectory=risulta-sprout
WorkingDirectory=/var/lib/risulta-sprout
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/risulta-sprout

[Install]
WantedBy=multi-user.target
