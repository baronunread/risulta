PORT=8099
SB_DATA_DIR=/var/lib/risulta-sprout
RISULTA_BASE_URL=https://analytics.example.com
SB_TRUSTED_PROXIES=127.0.0.1
RISULTA_PROXY_MODE=caddy
RISULTA_LOG_LEVEL=info

# Required only for the first startup. Remove these three lines after the
# administrator has been created; the password hash is stored in the database.
RISULTA_ADMIN_EMAIL=you@example.com
RISULTA_ADMIN_DISPLAY_NAME=Your name
RISULTA_ADMIN_PASSWORD=replace-with-a-long-unique-password
