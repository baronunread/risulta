PORT=3000
HOST=127.0.0.1
DATA_DIR=/var/lib/risulta
RISULTA_BASE_URL=https://analytics.example.com
RISULTA_TRUST_PROXY_CIDRS=127.0.0.1/32,::1/128
RISULTA_MAX_OPEN_SITES=32

# Required only for the first startup. Remove these two lines after the
# administrator has been created; the password hash is stored in control.db.
RISULTA_ADMIN_EMAIL=you@example.com
RISULTA_ADMIN_DISPLAY_NAME=Your name
RISULTA_ADMIN_PASSWORD=replace-with-a-long-unique-password
