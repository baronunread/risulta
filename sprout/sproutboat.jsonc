{
  "$schema": "https://sproutboat.com/schema.json",
  "name": "risulta-sprout",
  "main": "src/index.js",
  "compatibility_date": "2026-09-07",
  "vars": {
    "SITE_NAME": "Risulta Sprout",
    "TRACKER_VERSION": "0.1.0-probe"
  },
  "d1_databases": ["DB"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_sprout_first": true
  }
}
