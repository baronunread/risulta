{
  "$schema": "https://sproutboat.com/schema.json",
  "name": "risulta-sprout",
  "main": "src/index.js",
  "compatibility_date": "2026-09-07",
  "vars": {
    "SITE_NAME": "Risulta Sprout",
    "TRACKER_VERSION": "0.1.0-probe"
  },
  "d1_databases": ["DB"],
  "ratelimiters": [{ "binding": "INGEST", "limit": 240, "period": 60 }],
  "secrets": [
    "RISULTA_ADMIN_EMAIL",
    "RISULTA_ADMIN_DISPLAY_NAME",
    "RISULTA_ADMIN_PASSWORD"
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_sprout_first": true
  }
}
