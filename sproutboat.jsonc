{
  "$schema": "https://sproutboat.com/schema.json",
  "name": "risulta-sprout",
  "main": "src/standalone.js",
  "compatibility_date": "2026-11-18",
  "vars": {
    "SITE_NAME": "Risulta Sprout"
  },
  "d1_databases": ["DB"],
  "ratelimiters": [{ "binding": "INGEST", "limit": 240, "period": 60 }],
  "secrets": [
    "RISULTA_ADMIN_EMAIL",
    "RISULTA_ADMIN_DISPLAY_NAME",
    "RISULTA_ADMIN_PASSWORD",
    "RISULTA_BASE_URL",
    "RISULTA_LOG_LEVEL",
    "RISULTA_TRACKER_ORIGIN",
    "RISULTA_TRACKER_HOSTS",
    "RISULTA_CLOUD_ORIGIN",
    "RISULTA_CLOUD_ALLOW_LOOPBACK_HTTP"
  ],
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_sprout_first": true
  }
}
